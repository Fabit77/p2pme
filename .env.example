NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# mock is clearly disclosed and never creates a real transaction.
NEXT_PUBLIC_P2P_MODE=mock
NEXT_PUBLIC_P2P_NETWORK=baseSepolia
NEXT_PUBLIC_P2P_RPC_URL=
NEXT_PUBLIC_P2P_SUBGRAPH_URL=
NEXT_PUBLIC_P2P_DIAMOND_ADDRESS=
NEXT_PUBLIC_P2P_USDC_ADDRESS=
NEXT_PUBLIC_P2P_INTEGRATOR_ADDRESS=
NEXT_PUBLIC_P2P_CLIENT_ADDRESS=

# Embedded wallet provider, once selected/registered with P2P.me.
NEXT_PUBLIC_WALLET_PROVIDER_APP_ID=
WALLET_PROVIDER_SECRET=

# Server-only. Required to finalize a payment only after on-chain verification.
# Never prefix this value with NEXT_PUBLIC_ and never expose it in screenshots.
# SUPABASE_SERVICE_ROLE_KEY is already declared above and must be configured in Vercel for live mode.
