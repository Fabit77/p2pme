NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, comma-separated emails allowed to review withdrawal requests.
FONDO_ADMIN_EMAILS=

# mock is clearly disclosed and never creates a real transaction.
NEXT_PUBLIC_P2P_MODE=mock
NEXT_PUBLIC_P2P_NETWORK=baseSepolia
NEXT_PUBLIC_P2P_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_P2P_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1745491/event-indexer/v0.0.6
NEXT_PUBLIC_P2P_DIAMOND_ADDRESS=0xeb0BB8E3c014D915D9B2df03aBB130a1Fb44beb9
NEXT_PUBLIC_P2P_USDC_ADDRESS=0x4095fE4f1E636f11A95820BA2bB87F335Bd1040d
NEXT_PUBLIC_P2P_INTEGRATOR_ADDRESS=0x82Ec641720dA381C88aB351f9bDA4edfa06e9aeA
NEXT_PUBLIC_P2P_TREASURY_ADDRESS=0xA3B2BD9d16030d31b82B3E5a084f1A736ed9F769

# Public Privy App ID. Enable guest accounts, EVM wallets and Base Sepolia
# gas sponsorship in Privy. No App Secret or private key is used by checkout.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only. Required to finalize a payment only after on-chain verification.
# Never prefix this value with NEXT_PUBLIC_ and never expose it in screenshots.
# SUPABASE_SERVICE_ROLE_KEY is already declared above and must be configured in Vercel for live mode.
